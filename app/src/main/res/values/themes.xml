<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.RockPaperScissorsIR" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_base</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_light</item>
        <item name="colorSecondary">@color/accent_gold</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSurface">@color/persepolis_cream</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_main</item>
        <item name="android:windowBackground">@drawable/bg_persepolis</item>
        <item name="android:statusBarColor">@color/persepolis_shadow</item>
        <item name="android:navigationBarColor">@color/persepolis_shadow</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="GameButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
        <item name="android:textColor">@color/text_light</item>
        <item name="android:textSize">18sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="MenuButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
        <item name="android:textColor">@color/text_light</item>
        <item name="android:textSize">22sp</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_margin">12dp</item>
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">6dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TitleText">
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
        <item name="android:textColor">@color/text_light</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:shadowColor">@color/persepolis_shadow</item>
        <item name="android:shadowDx">2</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">4</item>
    </style>

    <style name="LabelText">
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="android:textColor">@color/text_light</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CoinText">
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
        <item name="android:textColor">@color/coin_gold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
